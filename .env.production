# Dourou - Configuration Production
# Remplir avec les vraies valeurs avant le build

# Supabase (Instance Production)
EXPO_PUBLIC_SUPABASE_URL=https://your-prod-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-prod-supabase-anon-key

# Plateforme Dourou
EXPO_PUBLIC_PROJECT_ID=your-prod-project-id
EXPO_PUBLIC_NEWELL_API_URL=https://api.example.com
EXPO_PUBLIC_AUTH_BROKER_URL=https://auth.example.com

# Environnement
EXPO_PUBLIC_ENVIRONMENT=production
