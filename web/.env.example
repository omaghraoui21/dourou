# ============================================================
# Dourou Web - Variables d'environnement
# ============================================================
#
# MODE DEMO : aucune variable requise — `npm run dev` puis
# « Essayer la demo » (cookie dourou_demo=1 + localStorage).
#
# MODE REEL : copiez ce fichier en `.env.local` et renseignez Supabase.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Deploiement demo uniquement (sans Supabase) :
NEXT_PUBLIC_DEMO_ONLY=
