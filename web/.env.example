# ============================================================
# Dourou Web - Variables d'environnement
# ============================================================
#
# Le MODE DEMO ne necessite AUCUNE de ces variables : lancez simplement
# `npm run dev` puis cliquez sur "Essayer la demo".
#
# Les variables ci-dessous ne sont requises que pour le MODE REEL
# (authentification par telephone/OTP et persistance via Supabase).
# Copiez ce fichier en `.env.local` et remplissez-les.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ------------------------------------------------------------
# Deploiement DEMO UNIQUEMENT (sans Supabase) :
# Mettez la valeur a "1" pour assumer explicitement un deploiement sans backend.
# Sans ce drapeau, un deploiement sans variables Supabase echoue FERME
# (acces au tableau de bord redirige vers /auth) pour eviter tout acces
# non authentifie en cas de mauvaise configuration en production.
# Laissez vide (ou supprimez) pour un deploiement reel avec Supabase.
NEXT_PUBLIC_DEMO_ONLY=
